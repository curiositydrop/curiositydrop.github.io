{
  "functions": [
    {
      "source": "mydealsportal-backend",
      "codebase": "mydealsportal",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "site": "mydealsportal",
    "public": "mydealsportal-preview",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "firestore": {
    "rules": "mydealsportal-preview/firestore.rules",
    "indexes": "mydealsportal-preview/firestore.indexes.json"
  }
}
